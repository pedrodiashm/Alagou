# O build do Expo Web é feito na máquina de deploy (scripts/testar-ec2.sh),
# que gera a pasta ./web-dist de forma determinística e estável.
# Aqui apenas servimos o estático em nginx (sem Node/npm/expo na EC2).
FROM nginx:1.27-alpine

RUN rm -rf /usr/share/nginx/html/*
COPY web-dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
